{
    "swagger": "2.0",
    "info": {
        "description": "Product search service.",
        "title": "Product Search API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/search": {
            "get": {
                "description": "Search for products by product_name, drug_generic, or company",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "Search for products",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Search query",
                        "name": "q",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/product.Product"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "product.Product": {
            "type": "object",
            "properties": {
                "company": {
                    "type": "string"
                },
                "drug_generic": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "product_name": {
                    "type": "string"
                },
                "score": {
                    "type": "number"
                }
            }
        }
    }
}